# 签到账号配置（JSON 必须保持单行）
#
# Any Router 邮箱密码登录（推荐）:
# ANYROUTER_ACCOUNTS=[{"email":"your@email.com","password":"your_password"}]
#
# Any Router + Agent Router:
# ANYROUTER_ACCOUNTS=[{"name":"AnyRouter","email":"any@example.com","password":"any_password"},{"name":"AgentRouter","provider":"agentrouter","email":"agent@example.com","password":"agent_password"}]
#
# Any Router Session 登录（兼容旧版）:
# ANYROUTER_ACCOUNTS=[{"cookies":{"session":"你的session值"},"api_user":"你的api_user值"}]
#
# 同时填写邮箱密码和 session 时，邮箱密码优先；登录失败后不会回退到旧 session。

ANYROUTER_ACCOUNTS=[{"email":"your@email.com","password":"your_password"}]

# 调试模式：true 时保存登录截图、输出代理地址/api_user 等详细日志（默认 false）
# DEBUG_MODE=false
# CHECKIN_BROWSER_FALLBACK=1
# CHECKIN_BROWSER_PROFILE_DIR=.browser_profiles
# CLOAKBROWSER_BINARY_PATH=/path/to/local/browser

# AgentRouter 在 GitHub Actions 中通常需要可用的 Clash/Mihomo 订阅
# CI 请配置 GitHub Environment Secret；本地可先运行 scripts/setup_mihomo_proxy.sh
# PROXY_SUBSCRIPTION_URL=https://example.com/sub?token=xxx
# PROXY_NODE_FILTER=香港|日本
# PROXY_TEST_URL=https://www.google.com/generate_204
# PROXY_PROBE_URL=https://ps.air-outer.com/api/status
# PROXY_PORT=7890
# PROXY_REQUIRED=false
# CHECKIN_PROXY_URL=http://127.0.0.1:7890
# PROVIDERS 可覆盖或添加平台；内置默认 anyrouter use_proxy=false、agentrouter use_proxy=true

# 可选：通知配置
# DINGDING_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# EMAIL_USER=your_email@example.com
# EMAIL_PASS=your_password
# EMAIL_TO=recipient@example.com
# EMAIL_SENDER=
# PUSHPLUS_TOKEN=your_pushplus_token
# SERVERPUSHKEY=your_server_pushkey
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# WEIXIN_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# GOTIFY_URL=https://your-gotify-server/message
# GOTIFY_TOKEN=your_gotify_token
# GOTIFY_PRIORITY=9
# BARK_KEY=your_bark_key
# BARK_SERVER=https://api.day.app
